{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/armsteadj1/proofrail/main/schema/proofrail.schema.json",
  "title": "Proofrail manifest (version 1)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "commands": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "cmd": {
            "type": "string",
            "minLength": 1,
            "description": "Executable to spawn. No shell is used; the string is the program name or path."
          },
          "args": {
            "default": [],
            "description": "Argument vector passed verbatim to the executable.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "description": "Working directory relative to the project root. Must stay inside the root.",
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "env": {
            "description": "Extra environment variables merged over the server environment.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "timeoutMs": {
            "default": 120000,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 600000
          },
          "maxOutputBytes": {
            "default": 65536,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 1048576
          },
          "focusedTest": {
            "description": "Declares that this command runs exactly one test. A zero exit can prove only the matching test proof.",
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "description": "Test file targeted by this focused command, relative to the project root."
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Exact test name targeted by this focused command."
              }
            },
            "required": [
              "file",
              "name"
            ],
            "additionalProperties": false
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "cmd"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "anchors": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "description": "File path relative to the project root."
                },
                "symbol": {
                  "description": "Declared symbol to locate (function, class, const, def, ...).",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "pattern": {
                  "description": "Regular expression; the first matching line becomes the anchor.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "lines": {
                  "description": "Explicit 1-based inclusive [start, end] line range.",
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "file"
              ],
              "additionalProperties": false
            }
          },
          "proofs": {
            "default": [],
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "command"
                    },
                    "command": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
                      "description": "Name of a command declared in manifest.commands."
                    },
                    "expect": {
                      "default": {
                        "exitCode": 0
                      },
                      "type": "object",
                      "properties": {
                        "exitCode": {
                          "default": 0,
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "stdoutIncludes": {
                          "type": "string"
                        },
                        "stderrIncludes": {
                          "type": "string"
                        },
                        "outputIncludes": {
                          "description": "Substring that must appear in stdout or stderr.",
                          "type": "string"
                        },
                        "outputMatches": {
                          "description": "Regular expression that must match stdout or stderr.",
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    },
                    "note": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "command"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "test"
                    },
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Exact test name that must appear in the file."
                    },
                    "command": {
                      "description": "Optional declared command whose output must include the test name and exit 0.",
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
                    },
                    "note": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "file",
                    "name"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "file-contains"
                    },
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pattern": {
                      "description": "Regular expression tested against the file contents.",
                      "type": "string",
                      "minLength": 1
                    },
                    "note": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "file"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "manual"
                    },
                    "note": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Why this cannot be checked automatically. Never counts as proof."
                    }
                  },
                  "required": [
                    "kind",
                    "note"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "reproducer": {
            "description": "Human-readable command to reproduce; defaults to the first dynamic proof.",
            "type": "string"
          },
          "done": {
            "description": "Done condition; defaults to a derived statement.",
            "type": "string"
          },
          "weight": {
            "default": 1,
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "statement"
        ],
        "additionalProperties": false
      }
    },
    "jev": {
      "type": "object",
      "properties": {
        "cmd": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeoutMs": {
          "default": 15000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 120000
        },
        "model": {
          "default": "jev-latest",
          "type": "string"
        }
      },
      "required": [
        "cmd"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "claims"
  ],
  "additionalProperties": false
}
